---
import Base from "../layouts/Base.astro";
---

<Base title="Not Found">
	<section class="squircle-lg border border-neutral-200 bg-neutral-50/70 p-10 text-center">
		<p class="font-mono text-[11px] uppercase tracking-[0.14em] text-neutral-400">
			Error 404
		</p>
		<h1 class="mt-2 font-serif text-4xl tracking-tight text-neutral-950">
			Page not found
		</h1>
		<p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-neutral-600">
			The page you're looking for doesn't exist or has moved within the Berbi Music Academy brandbook.
		</p>
		<a
			href="/"
			class="squircle-md mt-6 inline-flex items-center justify-center bg-neutral-900 px-4 py-2 text-xs font-medium text-white transition-colors hover:bg-neutral-800"
		>
			Return to Brand Guidelines
		</a>
	</section>
</Base>
