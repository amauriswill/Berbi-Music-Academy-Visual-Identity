---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import BrandFaviconLinks from "../components/astro/BrandFaviconLinks.astro";
import { applyPublicPageHeaders } from "../lib/securityHeaders";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import "../index.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

applyPublicPageHeaders(Astro.response.headers);

const { title, pageTitle, description, image, canonical, content } =
	Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en" data-corner-style="squircle">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<BrandFaviconLinks cmsFaviconUrl={settingsResult.data?.favicon?.url ?? null} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<EmDashHead page={pageCtx} />
	</head>
	<body class="min-h-screen bg-white text-neutral-900 antialiased selection:bg-neutral-900 selection:text-white">
		<EmDashBodyStart page={pageCtx} />

		<header class="border-b border-neutral-200 bg-white/95 backdrop-blur">
			<nav class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-6 py-4">
				<a href="/" class="text-base font-semibold tracking-tight text-neutral-950">
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								style="height:40px;width:auto;display:block;"
							/>
						) : (
							siteTitle
						)
					}
				</a>
				<div class="flex flex-wrap items-center gap-5 text-xs font-medium text-neutral-600">
					<a href="/" class="hover:text-neutral-950">Brand Guidelines</a>
					{
						menu?.items.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								class="hover:text-neutral-950"
							>
								{item.label}
							</a>
						))
					}
					<LiveSearch placeholder="Search..." collections={["posts", "pages"]} />
				</div>
			</nav>
		</header>

		<main class="mx-auto max-w-4xl px-6 py-12">
			<slot />
		</main>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
