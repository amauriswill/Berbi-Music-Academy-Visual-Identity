---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import BrandbookApp from "../components/BrandbookApp";
import BrandFaviconLinks from "../components/astro/BrandFaviconLinks.astro";
import { loadBrandConfigFromEmDash } from "../lib/emdashBrandLoader";
import { applyPublicPageHeaders } from "../lib/securityHeaders";
import "../index.css";

const { config, cmsStatus } = await loadBrandConfigFromEmDash();
applyPublicPageHeaders(Astro.response.headers, { degraded: !cmsStatus.connected });

const pageCtx = createPublicPageContext({
  Astro,
  kind: "custom",
  pageType: "website",
  title: `${config.brandName} — Brand Guidelines`,
  pageTitle: "Brand Guidelines",
  description: config.tagline,
  siteName: config.brandName,
});
---

<!doctype html>
<html lang="en" data-corner-style={config.cornerStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{config.brandName} — Brand Guidelines</title>
    <BrandFaviconLinks cmsFaviconUrl={cmsStatus.faviconUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <EmDashHead page={pageCtx} />
  </head>
  <body class="bg-white text-neutral-900 antialiased selection:bg-neutral-900 selection:text-white dark:bg-[#0D0E0D] dark:text-neutral-100">
    <EmDashBodyStart page={pageCtx} />
    <BrandbookApp
      client:load
      initialConfig={config}
      cmsConnected={cmsStatus.connected}
      cmsEntryCount={cmsStatus.entryCount}
    />
    <EmDashBodyEnd page={pageCtx} />
  </body>
</html>
